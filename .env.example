# Pulse — copy to `.env` at the repo root and fill in. Never commit `.env`.
# CA certificates: set EITHER *_CA_CERT_PATH (local file, e.g. ./certs/ca.pem — certs/ is gitignored)
# OR *_CA_CERT_BASE64 (for Render/Vercel: `base64 -i ca.pem | tr -d '\n'`). All Aiven services in one
# project share the same project CA, so the same value works for MySQL, PostgreSQL and Kafka.

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4100
WEB_ORIGIN=http://localhost:3100
# Long random string: `openssl rand -base64 48`
JWT_SECRET=change-me

# ── Aiven for MySQL (source of truth) ──────────────────────────────────────────
# Console → MySQL service → Overview → Connection information → "Service URI"
MYSQL_URL=mysql://avnadmin:PASSWORD@pulse-mysql-PROJECT.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# Console → Overview → "CA certificate" → Download
MYSQL_CA_CERT_PATH=./certs/ca.pem
MYSQL_CA_CERT_BASE64=

# ── Aiven for PostgreSQL + pgvector (semantic search) ──────────────────────────
# Console → PostgreSQL service → Overview → Connection information → "Service URI"
PG_URL=postgres://avnadmin:PASSWORD@pulse-pg-PROJECT.aivencloud.com:12345/defaultdb?sslmode=require
# Console → Overview → "CA certificate"
PG_CA_CERT_PATH=./certs/ca.pem
PG_CA_CERT_BASE64=

# ── Aiven for Apache Kafka (event backbone) ────────────────────────────────────
# First: Service settings → Advanced configuration → enable `kafka_authentication_methods.sasl`.
# Then Overview → Connection information → Authentication method "SASL":
#   "Host" + "Port"  → KAFKA_BROKERS (host:port; comma-separate if several)
#   "User"           → KAFKA_SASL_USERNAME
#   "Password"       → KAFKA_SASL_PASSWORD
#   "CA certificate" → KAFKA_CA_CERT_*
# Topics tab → create: messages.sent, messages.receipts, presence.events, ai.jobs, analytics.events
KAFKA_BROKERS=pulse-kafka-PROJECT.aivencloud.com:12346
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=PASSWORD
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_CLIENT_ID=pulse
KAFKA_CA_CERT_PATH=./certs/ca.pem
KAFKA_CA_CERT_BASE64=

# ── Aiven for Valkey (presence, typing, unread, sessions, caches, Socket.IO adapter) ──
# Console → Valkey service → Overview → Connection information → "Service URI" (starts with rediss://)
VALKEY_URL=rediss://default:PASSWORD@pulse-valkey-PROJECT.aivencloud.com:12347

# ── Aiven for OpenSearch (keyword search) ──────────────────────────────────────
# Console → OpenSearch service → Overview → Connection information → "Service URI" (https://user:pass@host:port)
OPENSEARCH_URL=https://avnadmin:PASSWORD@pulse-os-PROJECT.aivencloud.com:12348

# ── AI — provider/model chosen by env ──────────────────────────────────────────
# console.anthropic.com → API keys. AI_MODEL defaults to claude-opus-5-5.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
# Voyage AI (semantic search embeddings) — dash.voyageai.com → API keys
EMBED_PROVIDER=voyage
EMBED_API_KEY=
EMBED_MODEL=voyage-3.5

# ── Email OTP (optional; demo login works without it) — resend.com → API Keys ──
RESEND_API_KEY=
EMAIL_FROM=Pulse <onboarding@resend.dev>

# ── Hosting ────────────────────────────────────────────────────────────────────
# Comma-separated URLs the API pings every 10 min so free-tier services stay warm
# (e.g. https://pulse-worker.onrender.com/healthz).
KEEP_WARM_URLS=

# ── Media (Phase 2) ────────────────────────────────────────────────────────────
# Cloudinary dashboard → "API environment variable"
CLOUDINARY_URL=
